#### OpenSIPS 3.6.8 HA B2BUA policy
# Installed by shell provisioning and rendered from the schema-v2 runtime secret.

#### Core
log_level=2
stderror_enabled=no
syslog_enabled=yes
syslog_facility=LOG_LOCAL0
udp_workers=8
tcp_connection_lifetime=3600
mpath="/usr/lib/aarch64-linux-gnu/opensips/modules/"

socket=udp:@@PRIVATE_IP@@:5060 as @@ADVERTISED_IP@@:5060
socket=tls:@@PRIVATE_IP@@:5061 as @@ADVERTISED_IP@@:5061
socket=bin:@@PRIVATE_IP@@:5566

#### Modules
loadmodule "proto_udp.so"
loadmodule "sl.so"
loadmodule "tm.so"
loadmodule "maxfwd.so"
loadmodule "sipmsgops.so"
loadmodule "rr.so"
loadmodule "db_postgres.so"
loadmodule "proto_bin.so"
loadmodule "tls_openssl.so"
loadmodule "tls_mgm.so"
loadmodule "proto_tls.so"
loadmodule "clusterer.so"
loadmodule "dialog.so"
loadmodule "uac_auth.so"
loadmodule "b2b_entities.so"
loadmodule "b2b_logic.so"
loadmodule "rtpengine.so"
loadmodule "rest_client.so"
loadmodule "json.so"
loadmodule "cfgutils.so"

modparam("rest_client", "connection_timeout", 1)
modparam("rest_client", "curl_timeout", 3)
modparam("rest_client", "max_transfer_size", 4)
modparam("rest_client", "max_async_transfers", 64)

#### TLS: mutual TLS is required on the carrier TLS listener
modparam("tls_mgm", "server_domain", "carrier-in")
modparam("tls_mgm", "match_ip_address", "[carrier-in]@@PRIVATE_IP@@:5061")
modparam("tls_mgm", "match_sip_domain", "[carrier-in]*")
modparam("tls_mgm", "certificate", "[carrier-in]/run/opensips-secure/config/tls/certificate.pem")
modparam("tls_mgm", "private_key", "[carrier-in]/run/opensips-secure/config/tls/private-key.pem")
modparam("tls_mgm", "ca_list", "[carrier-in]/run/opensips-secure/config/tls/ca-bundle.pem")
modparam("tls_mgm", "tls_method", "[carrier-in]TLSv1_2-TLSv1_3")
modparam("tls_mgm", "verify_cert", "[carrier-in]1")
modparam("tls_mgm", "require_cert", "[carrier-in]1")

#### Cluster and replicated state
modparam("clusterer", "db_url", "@@DATABASE_URL@@")
modparam("clusterer", "my_node_id", @@NODE_ID@@)
modparam("clusterer", "ping_interval", 1)
modparam("clusterer", "ping_timeout", 500)
modparam("clusterer", "node_timeout", 5)
modparam("clusterer", "sharing_tag", "state-owner/@@CLUSTER_ID@@=@@STATE_OWNER@@")

modparam("dialog", "db_url", "@@DATABASE_URL@@")
modparam("dialog", "db_mode", 1)
modparam("dialog", "dialog_replication_cluster", @@CLUSTER_ID@@)

#### Placement uses PostgreSQL reservations and direct gateway observations.
# Never connect OpenSIPS to ESL: the fixed Sage gateway is its sole owner.

#### Replicated B2BUA state
modparam("b2b_entities", "db_url", "@@DATABASE_URL@@")
modparam("b2b_entities", "db_mode", 1)
modparam("b2b_entities", "cluster_id", @@CLUSTER_ID@@)
modparam("b2b_entities", "update_period", 5)
modparam("b2b_logic", "db_url", "@@DATABASE_URL@@")
modparam("b2b_logic", "db_mode", 1)
modparam("b2b_logic", "update_period", 5)
modparam("b2b_logic", "max_duration", 14400)
modparam("b2b_logic", "script_req_route", "B2B_REQUEST")
modparam("b2b_logic", "script_reply_route", "B2B_REPLY")
modparam("b2b_logic", "server_address", "sip:sbc@@@ADVERTISED_IP@@:5060")

#### RTPEngine set 1: replace both control endpoints and weights
modparam("rtpengine", "rtpengine_sock", "1 == @@RTPENGINE_NODES@@")
modparam("rtpengine", "setid_avp", "$avp(rtpengine_set)")
modparam("rtpengine", "error_pv", "$var(rtpengine_error)")
modparam("rtpengine", "rtpengine_tout", 1)
modparam("rtpengine", "rtpengine_retr", 2)
modparam("rtpengine", "rtpengine_disable_tout", 10)
modparam("rtpengine", "rtpengine_timer_interval", 1)
modparam("rtpengine", "ping_enabled", 1)

#### Initial carrier request route
route {
    force_rport();
    if (!sipmsg_validate("hrft", $var(sip_error))) {
        sl_send_reply(400, "Bad Request");
        exit;
    }
    if (!mf_process_maxfwd_header(16)) {
        sl_send_reply(483, "Too Many Hops");
        exit;
    }

    # This example accepts carrier traffic only. Add every production carrier
    # signaling address explicitly; never trust a SIP header as source identity.
    if (($socket_in(proto) == "udp" && @@CARRIER_UDP_REJECT@@) ||
        ($socket_in(proto) == "tls" && @@CARRIER_TLS_REJECT@@) ||
        ($socket_in(proto) != "udp" && $socket_in(proto) != "tls")) {
        sl_send_reply(403, "Forbidden");
        exit;
    }

    if (is_method("OPTIONS") && !has_totag()) {
        sl_send_reply(200, "OK");
        exit;
    }

    if (is_method("CANCEL")) {
        if (t_check_trans()) t_relay();
        exit;
    }

    if (!is_method("INVITE") || has_totag()) {
        sl_send_reply(405, "Method Not Allowed");
        exit;
    }

    # This baseline intentionally rejects late offer. Supporting SDP in the
    # first reliable response and ACK requires a separately tested B2B flow.
    if (!has_body("application/sdp")) {
        sl_send_reply(488, "SDP Offer Required");
        exit;
    }

    # Strip spoofed values case-insensitively, then construct the sole trusted
    # value from OpenSIPS's network source address pseudo-variable.
    remove_hf_glob("[xX]-[sS][aA][gG][eE]-*");
    $avp(sage_header_name) = "X-SAGE-Source-IP";
    $avp(sage_header_body) = $si;
    $avp(sage_header_name) = "X-SAGE-Edge-Call-ID";
    $avp(sage_header_body) = $ci;
    $avp(sage_header_name) = "X-SAGE-Edge-To";
    $avp(sage_header_body) = $tu;
    $avp(sage_header_name) = "X-SAGE-Edge-Port";
    $avp(sage_header_body) = $sp;
    $avp(sage_header_name) = "X-SAGE-Edge-Transport";
    $avp(sage_header_body) = $socket_in(proto);
    $avp(sage_product) = "voice";
    if (list_hdr_has_option("Require", "siprec") || list_hdr_has_option("Supported", "siprec")) {
        $avp(sage_product) = "siprec";
        list_hdr_remove_option("Require", "siprec");
    } else {
        if (has_body("multipart/mixed")) {
            append_to_reply("Require: siprec\r\n");
            sl_send_reply(421, "Extension Required");
            exit;
        }
        $avp(sage_header_name) = "X-SAGE-Voice-Ingress-Namespace";
        $avp(sage_header_body) = "@@VOICE_INGRESS_NAMESPACE@@";
        $avp(sage_header_name) = "X-SAGE-Voice-Requested-User";
        $avp(sage_header_body) = $rU;
        $avp(sage_header_name) = "X-SAGE-Voice-Requested-Domain";
        $avp(sage_header_body) = $rd;
    }

    route(SAGE_SELECT);
    exit;
}

route[SAGE_SETUP] {
    $avp(rtpengine_set) = 1;
    if (!rtpengine_offer("in-iface=external out-iface=internal replace-origin replace-session-connection ICE=remove", $var(rtpengine_socket))) {
        sl_send_reply(503, "Media Relay Unavailable");
        exit;
    }

    # These values become part of the replicated B2B context. A custom media
    # Call-ID is required because each B2B leg has its own signaling Call-ID.
    $b2b_logic.ctx(media_callid) = $ci;
    $b2b_logic.ctx(media_fromtag) = $ft;
    $b2b_logic.ctx(media_socket) = $var(rtpengine_socket);
    $b2b_logic.ctx(source_ip) = $si;
    $b2b_logic.ctx(freeswitch_uri) = $du;
    $b2b_logic.ctx(allocation_id) = $avp(sage_allocation);

    if ($socket_in(proto) == "tls") {
        $var(carrier_contact) = "sip:sbc@@@ADVERTISED_IP@@:5061;transport=tls";
    } else {
        $var(carrier_contact) = "sip:sbc@@@ADVERTISED_IP@@:5060";
    }
    b2b_server_new("carrier", $var(carrier_contact));
    force_send_socket("udp:@@PRIVATE_IP@@:5060");
    $var(source_name) = $fn;
    if ($var(source_name) == NULL) $var(source_name) = "";
    # Argument five is the advertised Contact, not the From URI. The module
    # preserves the source From URI; backend dialog requests return to this edge.
    $var(backend_contact) = "sip:sbc@@@PRIVATE_IP@@:5060";
    b2b_client_new("freeswitch", $ru, $du, $var(source_name), $var(backend_contact),
        $avp(sage_header_name), $avp(sage_header_body));
    # The setup and maximum-duration timers are replicated. Monitoring must
    # tolerate duplicate idempotent teardown messages from surviving nodes and
    # remove any orphaned RTPEngine allocation after timeout.
    b2b_init_request("sage-freeswitch", "setup-timeout=30", "B2B_REQUEST", "B2B_REPLY");
    exit;
}

# BEGIN POSTGRES PLACEMENT ROUTES
route[SAGE_SELECT] {
    if ($ml > 16384) {
        sl_send_reply(513, "Message Too Large");
        exit;
    }
    if (t_check_trans()) exit;
    $var(identity) = $ci + "|" + $ft + "|" + $hdr(CSeq) + "|" + $si;
    $avp(sage_allocation) = $(var(identity){s.sha256});
    $var(fingerprint) = $ru + "|" + $fu + "|" + $tu + "|" + $hdr(Contact) + "|" + $rb;
    $var(request_hash) = $(var(fingerprint){s.sha256});
    $var(product) = "voice";
    $var(cost) = "1";
    if ($avp(sage_product) == "siprec" || list_hdr_has_option("Require", "siprec") || list_hdr_has_option("Supported", "siprec")) {
        $var(product) = "siprec";
        $var(cost) = "3";
    }
    $var(body) = "{\"allocation_id\":\"" + $avp(sage_allocation) + "\",\"request_sha256\":\"" + $var(request_hash) +
        "\",\"product\":\"" + $var(product) + "\",\"channels\":" + $var(cost) + ",\"ttl_ms\":30000}";
    # Keep the global bound below rest_client's per-worker async limit: no blocking fallback.
    get_static_lock("sage-placement-capacity");
    if ($shv(placement_active) >= 32) {
        release_static_lock("sage-placement-capacity");
        sl_send_reply(503, "Placement Busy");
        exit;
    }
    $shv(placement_active) = $shv(placement_active) + 1;
    release_static_lock("sage-placement-capacity");
    rest_append_hf("Authorization: Bearer @@PLACEMENT_TOKEN@@");
    async(rest_post("http://127.0.0.1:8095/v1/reservations", $var(body), "application/json",
                    $avp(placement_body), , $avp(placement_status)), SAGE_SELECTED);
    exit;
}

route[SAGE_SELECTED] {
    $var(placement_result) = $rc;
    get_static_lock("sage-placement-capacity");
    $shv(placement_active) = $shv(placement_active) - 1;
    release_static_lock("sage-placement-capacity");
    if (t_was_cancelled()) {
        t_reply(487, "Request Terminated");
        exit;
    }
    if ($var(placement_result) < 0 || $avp(placement_status) != 200) {
        t_reply(503, "Placement Unavailable");
        exit;
    }
    $json(placement) := $avp(placement_body);
    # json exports booleans as strings; numeric comparison treats both nonempty values as true.
    if ($json(placement/schema_version) != "1.0.0" ||
        $json(placement/allocation_id) != $avp(sage_allocation) || $json(placement/fresh) != "true") {
        # A replay must not create another SIP dialog after an uncertain first dispatch.
        t_reply(503, "Placement Replay Requires Existing Transaction");
        exit;
    }
    $du = $json(placement/destination);
    route(SAGE_SETUP);
    exit;
}

route[SAGE_NOTIFY] {
    if (!($var(notify_id) =~ "^[a-f0-9]{64}$")) return;
    get_static_lock("sage-placement-capacity");
    if ($shv(placement_active) >= 32) {
        release_static_lock("sage-placement-capacity");
        # SQL expiry remains conservative if this best-effort notification cannot launch.
        return;
    }
    $shv(placement_active) = $shv(placement_active) + 1;
    release_static_lock("sage-placement-capacity");
    $var(notify_url) = "http://127.0.0.1:8095/v1/reservations/" + $var(notify_id) + "/" + $var(notify_action);
    rest_append_hf("Authorization: Bearer @@PLACEMENT_TOKEN@@");
    launch(rest_post($var(notify_url), "{}", "application/json", $var(notify_body)), SAGE_NOTIFIED);
}

route[SAGE_NOTIFIED] {
    get_static_lock("sage-placement-capacity");
    $shv(placement_active) = $shv(placement_active) - 1;
    release_static_lock("sage-placement-capacity");
    exit;
}
# END POSTGRES PLACEMENT ROUTES

#### Requests for established B2B sessions
route[B2B_REQUEST] {
    # Sequential caller headers must not replace the original trusted ingress context.
    remove_hf_glob("[xX]-[sS][aA][gG][eE]-*");
    $avp(rtpengine_set) = 1;
    $var(media_flags) = "in-iface=external out-iface=internal replace-origin replace-session-connection ICE=remove call-id=" +
        $b2b_logic.ctx(media_callid) + " from-tag=" + $b2b_logic.ctx(media_fromtag);

    if (is_method("BYE") || is_method("CANCEL")) {
        $var(notify_id) = $b2b_logic.ctx(allocation_id);
        $var(notify_action) = "release";
        route(SAGE_NOTIFY);
        rtpengine_delete($var(media_flags), $b2b_logic.ctx(media_socket));
        b2b_pass_request();
        exit;
    }

    if ((is_method("INVITE") || is_method("UPDATE")) && has_body("application/sdp")) {
        $var(candidate_socket) = $b2b_logic.ctx(media_socket);
        if (!rtpengine_offer($var(media_flags), $var(candidate_socket)) ||
            $var(candidate_socket) != $b2b_logic.ctx(media_socket)) {
            if ($var(candidate_socket) != $b2b_logic.ctx(media_socket)) {
                rtpengine_delete($var(media_flags), $var(candidate_socket));
            }
            b2b_send_reply(500, "Media Renegotiation Failed");
            exit;
        }
    }

    b2b_pass_request();
    exit;
}

#### Replies for established B2B sessions
route[B2B_REPLY] {
    if ($rm == "INVITE" && $rs >= 200 && $rs < 300) {
        $var(notify_id) = $b2b_logic.ctx(allocation_id);
        $var(notify_action) = "confirm";
        route(SAGE_NOTIFY);
    } else if ($rm == "INVITE" && $rs >= 300) {
        $var(notify_id) = $b2b_logic.ctx(allocation_id);
        $var(notify_action) = "release";
        route(SAGE_NOTIFY);
    }
    $avp(rtpengine_set) = 1;
    $var(media_flags) = "in-iface=internal out-iface=external replace-origin replace-session-connection ICE=remove call-id=" +
        $b2b_logic.ctx(media_callid) + " from-tag=" + $b2b_logic.ctx(media_fromtag);

    if ($rm == "INVITE" && $rs >= 180 && $rs < 300 && has_body("application/sdp")) {
        $var(candidate_socket) = $b2b_logic.ctx(media_socket);
        if (!rtpengine_answer($var(media_flags), $var(candidate_socket)) ||
            $var(candidate_socket) != $b2b_logic.ctx(media_socket)) {
            if ($var(candidate_socket) != $b2b_logic.ctx(media_socket)) {
                rtpengine_delete($var(media_flags), $var(candidate_socket));
            }
            rtpengine_delete($var(media_flags), $b2b_logic.ctx(media_socket));
            b2b_end_dlg_leg();
            exit;
        }
    } else if ($rm == "INVITE" && $rs >= 300) {
        rtpengine_delete($var(media_flags), $b2b_logic.ctx(media_socket));
    }

    b2b_handle_reply();
    exit;
}
