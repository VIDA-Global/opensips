[Unit]
Description=OpenSIPS SIP server
Documentation=https://www.opensips.org/Documentation/Manual-3-6
Requires=opensips-runtime-config.service
After=network-online.target opensips-runtime-config.service opensips-placement.service
Wants=network-online.target opensips-placement.service

[Service]
Type=simple
User=opensips
Group=opensips
UMask=0027
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy
RuntimeDirectory=opensips
RuntimeDirectoryMode=0750
StateDirectory=opensips
StateDirectoryMode=0750
LogsDirectory=opensips
LogsDirectoryMode=0750
ExecStartPre=/usr/bin/python3 /usr/local/lib/opensips-placement/ownership_guard.py
ExecStartPre=/usr/sbin/opensips -C -f /run/opensips-secure/config/opensips.cfg
ExecStart=/usr/bin/tini -- /usr/sbin/opensips -F -f /run/opensips-secure/config/opensips.cfg
# Configuration replacement requires a controlled restart; SIGHUP is ignored.
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
TimeoutStartSec=15s
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/run/opensips /var/lib/opensips /var/log/opensips
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
