<?xml version="1.0"?>
<!-- Isolated synthetic endpoint proof only. No ESL, public listener or production policy. -->
<document type="freeswitch/xml">
  <section name="configuration">
    <configuration name="modules.conf">
      <modules>
        <load module="mod_console"/>
        <load module="mod_sofia"/>
        <load module="mod_dptools"/>
        <load module="mod_dialplan_xml"/>
        <load module="mod_sndfile"/>
      </modules>
    </configuration>
    <configuration name="switch.conf">
      <settings>
        <param name="rtp-start-port" value="40000"/>
        <param name="rtp-end-port" value="40999"/>
      </settings>
    </configuration>
    <configuration name="sofia.conf">
      <global_settings/>
      <profiles>
        <profile name="demux-proof">
          <aliases/>
          <gateways/>
          <domains/>
          <settings>
            <param name="sip-ip" value="127.0.0.1"/>
            <param name="rtp-ip" value="127.0.0.1"/>
            <param name="sip-port" value="15062"/>
            <param name="context" value="demux-proof"/>
            <param name="dialplan" value="XML"/>
            <param name="inbound-codec-prefs" value="PCMA"/>
            <param name="outbound-codec-prefs" value="PCMA"/>
            <param name="disable-hold" value="true"/>
            <param name="auth-calls" value="false"/>
            <param name="tls" value="false"/>
          </settings>
        </profile>
      </profiles>
    </configuration>
  </section>
  <section name="dialplan">
    <context name="demux-proof">
      <extension name="synthetic-recording">
        <condition field="destination_number" expression="^record$">
          <action application="set" data="RECORD_STEREO=false"/>
          <action application="answer"/>
          <action application="record_session" data="/tmp/demux-${uuid}.wav"/>
          <action application="park"/>
        </condition>
      </extension>
    </context>
  </section>
</document>
