[Unit]
Description=OpenSIPS SIP server
Documentation=https://www.opensips.org/Documentation/Manual-3-6
Requires=opensips-runtime-config.service
After=network-online.target opensips-runtime-config.service
Wants=network-online.target

[Service]
Type=simple
User=opensips
Group=opensips
UMask=0027
RuntimeDirectory=opensips
RuntimeDirectoryMode=0750
StateDirectory=opensips
StateDirectoryMode=0750
LogsDirectory=opensips
LogsDirectoryMode=0750
ExecStartPre=/usr/sbin/opensips -C -f /run/opensips-secure/config/opensips.cfg
ExecStart=/usr/bin/tini -- /usr/sbin/opensips -FE -f /run/opensips-secure/config/opensips.cfg
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/run/opensips /var/lib/opensips /var/log/opensips
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
