{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ObserveApprovedRegion",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "${AWS_REGION}"}}
    },
    {
      "Sid": "FenceOnlyApprovedOwnershipNamespace",
      "Effect": "Allow",
      "Action": "ec2:TerminateInstances",
      "Resource": "arn:${AWS_PARTITION}:ec2:${AWS_REGION}:${AWS_ACCOUNT_ID}:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${AWS_REGION}",
          "ec2:ResourceTag/OpenSIPSOwnershipNamespace": "${OWNERSHIP_NAMESPACE}"
        }
      }
    }
  ]
}
