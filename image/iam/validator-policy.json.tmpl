{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ValidateImageLifecycle",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteKeyPair",
        "ec2:DescribeImages",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeVolumes",
        "ec2:ImportKeyPair",
        "ec2:RebootInstances",
        "ec2:RunInstances",
        "ec2:TerminateInstances"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyUntaggedValidationLaunches",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestTag/Purpose": "ami-validation"
        }
      }
    },
    {
      "Sid": "DenyLifecycleAccessToNonValidationInstances",
      "Effect": "Deny",
      "Action": [
        "ec2:RebootInstances",
        "ec2:TerminateInstances"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "ec2:ResourceTag/Purpose": "ami-validation"
        }
      }
    },
    {
      "Sid": "DenyUnrelatedKeyPairDeletion",
      "Effect": "Deny",
      "Action": "ec2:DeleteKeyPair",
      "NotResource": "arn:aws:ec2:${AWS_REGION}:${AWS_ACCOUNT_ID}:key-pair/opensips-ami-validation-*"
    },
    {
      "Sid": "UseSourceImageKmsKey",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey"
      ],
      "Resource": "${BUILD_KMS_KEY_ARN}"
    },
    {
      "Sid": "CreateSourceImageKmsGrant",
      "Effect": "Allow",
      "Action": "kms:CreateGrant",
      "Resource": "${BUILD_KMS_KEY_ARN}",
      "Condition": {
        "Bool": {
          "kms:GrantIsForAWSResource": "true"
        }
      }
    },
    {
      "Sid": "PassOnlyValidationProfile",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "${VALIDATION_INSTANCE_ROLE_ARN}",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    }
  ]
}
